# eslint-config-next@16 declares a peer of eslint>=9 while we're still on
# eslint 8 (the v9 flat-config migration is parked). Builds never run
# ESLint (Next 16 doesn't lint during `next build`), so the strict peer
# check only blocks `npm install` on fresh machines — Vercel included.
# Remove this when the ESLint 9 migration lands.
legacy-peer-deps=true
