# ── Required (production refuses to boot without these — lib/config.ts) ──

# Local Postgres connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/traverse

# Supabase auth. When unset in development, the app uses a seeded dev user
# (00000000-0000-0000-0000-000000000001) and skips all auth checks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key for the generation engine
ANTHROPIC_API_KEY=

# ── Optional (features degrade gracefully when unset) ────────────────────

# Upstash Redis: generated-node cache + rate limiting.
# Falls back to an in-memory cache and no-op rate limits in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe billing — required only once subscriptions go live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 32-byte hex key for encrypting operator BYOK Anthropic keys (AES-256-GCM).
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=

# Resend transactional email — silent no-op when unset
RESEND_API_KEY=

# ElevenLabs TTS — DIALOGUE actors speak their lines when set (voice Phase 1).
# Unset → voice UI is hidden and dialogues stay text-only.
ELEVENLABS_API_KEY=
# Fallback voice for actors without a cast voice in their contextPack profile
ELEVENLABS_DEFAULT_VOICE_ID=

# Engine tuning
# GENERATION_CONCURRENCY=5   # p-queue concurrency per process (not a global limit)
